# Run commands from backend/ so this file's copy is discovered.
APP_NAME=AI Knowledge Hub API
# Explicit local demo by default. See README for enabling private local accounts.
APP_MODE=local-demo
APP_ENV=development
# Required for authenticated mode; generate a random 32+ character key.
SECURITY_KEY=
ALLOW_REGISTRATION=false
AUTH_COOKIE_SECURE=false
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
SESSION_HOURS=8
LOGIN_IP_PER_MINUTE=20
LOGIN_ACCOUNT_PER_15MIN=10
REQUESTS_PER_MINUTE=120
CHAT_PER_MINUTE=20
UPLOADS_PER_HOUR=30
MAX_DOCUMENTS_PER_USER=50
MAX_STORAGE_BYTES_PER_USER=209715200
MAX_CHUNKS_PER_USER=10000
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# Match the port/credentials in infra/.env, or use a loopback SSH tunnel to a
# dedicated project database on your server. URL-encode special password characters.
DATABASE_URL=postgresql+psycopg://knowledge_hub:local_demo_only_change_me@127.0.0.1:5432/knowledge_hub
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARS=2000000
# Fake remains local and explicitly labeled, even if a key exists.
AI_PROVIDER=fake
# Only used with AI_PROVIDER=openai. Never place this in frontend config.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-4.1-mini
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
